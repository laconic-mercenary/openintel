FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -a -installsuffix cgo -o authapi.app ./cmd/auth

FROM alpine:3.21

LABEL org.opencontainers.image.source="https://github.com/laconic-mercenary/openintel"
LABEL org.opencontainers.image.description="openintel-authapi"
LABEL org.opencontainers.image.licenses="UNLICENSED"

RUN addgroup -g 1001 -S authapi && \
    adduser -u 1001 -S authapi -G authapi

WORKDIR /app

COPY --from=builder /app/authapi.app .

RUN chown -R authapi:authapi /app

USER authapi

EXPOSE 8080

CMD ["./authapi.app"]