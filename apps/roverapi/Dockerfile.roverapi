FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -a -installsuffix cgo -o roverapi.app ./cmd/rover

FROM alpine:3.21

LABEL org.opencontainers.image.source="https://github.com/laconic-mercenary/openintel"
LABEL org.opencontainers.image.description="openintel-roverapi"
LABEL org.opencontainers.image.licenses="UNLICENSED"

RUN addgroup -g 1001 -S roverapi && \
    adduser -u 1001 -S roverapi -G roverapi

WORKDIR /app

COPY --from=builder /app/roverapi.app .

RUN chown -R roverapi:roverapi /app

USER roverapi

EXPOSE 8081

CMD ["./roverapi.app"]